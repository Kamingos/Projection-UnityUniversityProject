  - CharacterName: "\u0420\u0430\u0431\u043E\u0442\u043D\u0438\u043A \u0446\u0435\u043D\u0442\u0440\u0430"
    Description: "\u042D\u0442\u043E \u0432\u044B, \u043C\u044B \u0432\u0430\u0441
      \u0437\u0430\u0436\u0434\u0430\u043B\u0438\u0441\u044C"
    TimeDelay: 4
    icon: {fileID: 2800000, guid: b8a9bb78fc55c3148b6e4a5ec100cf76, type: 3}
  - CharacterName: "\u0420\u0430\u0431\u043E\u0442\u043D\u0438\u043A \u0446\u0435\u043D\u0442\u0440\u0430"
    Description: "\u041F\u043E\u0434\u0441\u0443\u0434\u0438\u043C\u043E\u0433\u043E
      \u0443\u0436\u0435 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u043B\u0438
      \u043A \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0443 "
    TimeDelay: 4
    icon: {fileID: 2800000, guid: b8a9bb78fc55c3148b6e4a5ec100cf76, type: 3}
  - CharacterName: "\u0413\u043B\u0430\u0432\u043D\u044B\u0439 \u0433\u0435\u0440\u043E\u0439"
    Description: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E, \u043C\u043E\u0436\u0435\u0442\u0435
      \u043D\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C \u0446\u0435\u043B\u044C
      \u043C\u043E\u0435\u0433\u043E \u0432\u043D\u0435\u0434\u0440\u0435\u043D\u0438\u044F?"
    TimeDelay: 6
    icon: {fileID: 2800000, guid: bbc408298536bef49bdfaa472c398683, type: 3}
  - CharacterName: "\u0420\u0430\u0431\u043E\u0442\u043D\u0438\u043A \u0446\u0435\u043D\u0442\u0440\u0430"
    Description: "\u041A\u043E\u0433\u0434\u0430 \u043C\u044B \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u043C
      \u0432\u0430\u0441 \u043A \u0430\u043F\u043F\u0430\u0440\u0430\u0442\u0443
      \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0430 \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u044F,
      \u0432\u044B \u043F\u043E\u043F\u0430\u0434\u0451\u0442\u0435 \u0432 \u0446\u0438\u0444\u0440\u043E\u0432\u043E\u0439
      \u0445\u0430\u0431, \u043E\u0442\u043A\u0443\u0434\u0430 \u0447\u0435\u0440\u0435\u0437
      \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435 \u043C\u0438\u0440\u044B
      \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u0443\u0432\u0438\u0434\u0435\u0442\u044C
      \u0430\u043B\u043B\u0435\u0433\u043E\u0440\u0438\u044E \u043D\u0430 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u044F\u0449\u0438\u0435
      \u0441\u043E\u0431\u044B\u0442\u0438\u044F \u0432 \u0436\u0438\u0437\u043D\u0438
      \u044D\u0442\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430"
    TimeDelay: 12
    icon: {fileID: 2800000, guid: b8a9bb78fc55c3148b6e4a5ec100cf76, type: 3}
  - CharacterName: "\u0420\u0430\u0431\u043E\u0442\u043D\u0438\u043A \u0446\u0435\u043D\u0442\u0440\u0430"
    Description: "\u041D\u0430 \u0434\u0430\u043D\u043D\u044B\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
      \u043C\u044B \u043C\u043E\u0436\u0435\u043C \u0441\u043F\u0440\u043E\u0435\u0446\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043B\u0438\u0448\u044C \u043E\u0431\u0440\u0430\u0437\u044B, \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0435
      \u0441 \u0441\u043E\u0431\u044B\u0442\u0438\u044F\u043C\u0438, \u043F\u0435\u0440\u0435\u0436\u0438\u0442\u044B\u043C\u0438
      \u044D\u0442\u0438\u043C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C"
    TimeDelay: 10
    icon: {fileID: 2800000, guid: b8a9bb78fc55c3148b6e4a5ec100cf76, type: 3}
  - CharacterName: "\u0420\u0430\u0431\u043E\u0442\u043D\u0438\u043A \u0446\u0435\u043D\u0442\u0440\u0430"
    Description: "\u041D\u043E \u0434\u0430\u0436\u0435 \u0442\u0430\u043A, \u043F\u043E\u043B\u0430\u0433\u0430\u044E,
      \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u044B\u043D\u0435\u0441\u0442\u0438
      \u0434\u043B\u044F \u0441\u0435\u0431\u044F \u0432\u0441\u044E \u043D\u0443\u0436\u043D\u0443\u044E
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E"
    TimeDelay: 6
    icon: {fileID: 2800000, guid: b8a9bb78fc55c3148b6e4a5ec100cf76, type: 3}
  - CharacterName: "\u0414\u0435\u0442\u0435\u043A\u0442\u0438\u0432"
    Description: "\u041F\u043E\u043D\u044F\u043B, \u0442\u043E\u0433\u0434\u0430
      \u044F \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0430\u044E"
