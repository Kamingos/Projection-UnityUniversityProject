  DialogList:
  - CharacterName: "\u0414\u0435\u0442\u0435\u043A\u0442\u0438\u0432"
    Description: "\u041D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E \u044F
      \u043D\u0430\u0448\u0451\u043B \u044D\u0442\u043E\u0442 \u043A\u0430\u0431\u0438\u043D\u0435\u0442"
